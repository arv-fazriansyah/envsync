{
  "name": "envsync",
  "version": "0.1.0",
  "description": "Universal environment secrets sync - encrypted, git-friendly, multi-platform",
  "type": "module",
  "bin": {
    "envsync": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm run test && npm run lint"
  },
  "keywords": [
    "secrets",
    "env",
    "environment",
    "sync",
    "encryption",
    "age",
    "1password",
    "doppler",
    "infisical",
    "github-actions",
    "vercel",
    "netlify"
  ],
  "author": "Arvib Fazriansyah",
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/INSTALL.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "age-encryption": "^0.3.1",
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0",
    "libsodium-wrappers": "^0.8.4",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^8.57.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
