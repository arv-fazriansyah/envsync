{
  "name": "@arv.fazriansyah/envsync",
  "version": "0.1.2",
  "description": "envsync - sync, encrypt and manage environment variables and secrets across dotenv, 1Password, Doppler, GitHub Actions, Vercel and more. Age-encrypted CLI for Node.js.",
  "type": "module",
  "bin": {
    "envsync": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm run test && npm run lint"
  },
  "keywords": [
    "secrets",
    "secrets-management",
    "environment-variables",
    "env",
    "environment",
    "sync",
    "dotenv",
    "encryption",
    "age",
    "age-encryption",
    "cli",
    "devtools",
    "config",
    "config-management",
    "devops",
    "security",
    "1password",
    "doppler",
    "vercel",
    "github-actions",
    "netlify",
    "infisical"
  ],
  "author": "Arvib Fazriansyah",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arv-fazriansyah/envsync.git"
  },
  "homepage": "https://github.com/arv-fazriansyah/envsync#readme",
  "bugs": {
    "url": "https://github.com/arv-fazriansyah/envsync/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/INSTALL.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "age-encryption": "^0.3.1",
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0",
    "libsodium-wrappers": "^0.8.4",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^8.57.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
